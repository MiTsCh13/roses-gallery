# Copy to .env.local and fill in. Never commit real secrets.

# --- Core (required) ---
DATABASE_URL=postgres://roses:roses@localhost:5432/roses_gallery
REDIS_URL=redis://localhost:6379

# --- Auth.js (M1) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Postmark (M1, M9) ---
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=

# --- Stripe, test mode (M2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 (M3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Bunny Stream (M4) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# --- Sentry, EU region (M10) ---
SENTRY_DSN=
